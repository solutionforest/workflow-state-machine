includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 5
    paths:
        - src
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        -
            identifier: missingType.iterableValue
        # These traits are the package's public API: they are used by the
        # applications that install it, not from within src. PHPStan 2 reports
        # a trait it cannot see used, which here is expected.
        -
            identifier: trait.unused
